rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User document and all nested subcollections (tasks, routines, settings, streaks)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{allPaths=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Fallback: Allow read & write for signed-in users across documents
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}

