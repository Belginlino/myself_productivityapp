rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // --- Helper Functions -----------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Max file size in MB
    function maxMB(mb) {
      return request.resource.size <= mb * 1024 * 1024;
    }

    // Allowed image MIME types
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // Allowed document/text MIME types
    function isDocument() {
      return request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('application/pdf')
          || request.resource.contentType.matches('text/.*');
    }

    // --- Deny all by default --------------------------------------------------
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // --- users/{uid}/profile/ -------------------------------------------------
    // Profile photos: images only, max 5 MB
    match /users/{uid}/profile/{filename} {
      allow read:   if isOwner(uid);
      allow write:  if isOwner(uid)
                    && isImage()
                    && maxMB(5);
      allow delete: if isOwner(uid);
    }

    // --- users/{uid}/journal/ -------------------------------------------------
    // Journal photos: images only, max 10 MB each
    match /users/{uid}/journal/{filename} {
      allow read:   if isOwner(uid);
      allow write:  if isOwner(uid)
                    && isImage()
                    && maxMB(10);
      allow delete: if isOwner(uid);
    }

    // --- users/{uid}/notes/ ---------------------------------------------------
    // Note images/attachments: images + documents, max 10 MB each
    match /users/{uid}/notes/{filename} {
      allow read:   if isOwner(uid);
      allow write:  if isOwner(uid)
                    && isDocument()
                    && maxMB(10);
      allow delete: if isOwner(uid);
    }

    // --- users/{uid}/attachments/ ---------------------------------------------
    // General attachments: images + documents, max 25 MB each
    match /users/{uid}/attachments/{filename} {
      allow read:   if isOwner(uid);
      allow write:  if isOwner(uid)
                    && isDocument()
                    && maxMB(25);
      allow delete: if isOwner(uid);
    }

  }
}
